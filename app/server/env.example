# Copy this to app/.env and fill in your values
#
# ============================================================
# REQUIRED - Contract Deployment (Unichain Sepolia)
# ============================================================
RPC_URL=https://sepolia.unichain.org
CHAIN_ID=1301

# PRIVATE_KEY is loaded from ../contracts/.env (shared with deployer/agent)
# AGENT_ADDRESS also loaded from contracts/.env
AGENT_ADDRESS=0x8A0ac096D9494d69e47BC3ad12060f0a727faAE4

# ============================================================
# REQUIRED - Contract Addresses (Unichain Sepolia)
# ============================================================
ORACLE_RELAYER_ADDRESS=0x8A7bA8e02fD429607a32F81089Ca6582e4ACbf12
GRINTA_ENGINE_ADDRESS=0x3Ca116ac93920cfefd588a41b9B29fb2AD840005
PID_CONTROLLER_ADDRESS=0x908cfBAEd216A7F5cE6fe0D20ADF8b0d019D2bd4
GRINTA_HOOK_ADDRESS=0x63a1F84fa3cFB4269afC7063E8E87935AD9Ec040
PARAMETER_GUARD_ADDRESS=0xC5e659Db76111cdABC624f8078a6D881a16A53A5
WBTC_ADDRESS=0x141E32C0add68B5CF0d597Cf39FD21CD37580543
USDC_ADDRESS=0xa5CfcF29A7C0E6f9f875b68AF1DA7f322009e1c8
SWAP_HELPER_ADDRESS=0x55C119A3D32637eDF3E945FDE316E7F19Ae8A8B5

# Pool config (must match SetupPool.s.sol)
POOL_FEE=100
POOL_TICK_SPACING=1

# ============================================================
# REQUIRED - LLM Provider
# ============================================================
# Choose provider: "openrouter" (default) or "zerog"
LLM_PROVIDER=zerog

# --- OpenRouter (default fallback) ---
LLM_API_KEY=sk-or-v1-minimax-minimax-m2.5-free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=minimax/minimax-m2.5:free

# --- 0G Compute (use if LLM_PROVIDER=zerog) ---
ZEROG_COMPUTE_URL=https://compute-network-6.integratenetwork.work
ZEROG_COMPUTE_API_KEY=app-sk-
ZEROG_COMPUTE_MODEL=qwen/qwen-2.5-7b-instruct

# --- 0G Storage (PDR persistence) ---
ZEROG_STORAGE_PRIVATE_KEY=0x...your_private_key...

# ============================================================
# Optional - Filecoin archive
# ============================================================
# LIGHTHOUSE_API_KEY=

# ============================================================
# Server config
# ============================================================
PORT=3001