# EVM RPC (Unichain Sepolia)
RPC_URL=https://sepolia.unichain.org

# Agent wallet (EOA) — MUST match proposer address on ParameterGuard
AGENT_PRIVATE_KEY=0x...
AGENT_ADDRESS=0x...

# LLM Provider (optional — falls back to rule-based if not set)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# 0G Compute (optional — for decentralized inference)
ZEROG_COMPUTE_URL=
ZEROG_STORAGE_URL=

# Uniswap API (for sponsor integration)
UNISWAP_POOL_ID=ETH/USDC

# KeeperHub (optional — for tx execution)
KEEPERHUB_URL=

# Contracts (deploy addresses)
PARAMETER_GUARD_ADDRESS=0x...
PID_CONTROLLER_ADDRESS=0x...
GRINTA_ENGINE_ADDRESS=0x...
ORACLE_RELAYER_ADDRESS=0x...

# Agent behavior
CHECK_INTERVAL_MS=15000
EMERGENCY_DEVIATION_THRESHOLD=0.05